from __future__ import annotations

from collections.abc import Sequence
from typing import Any, Protocol

OK: int
STEP_FINISHED: int
RUN_LIMIT_REACHED: int
RUN_SNAPSHOT_REQUESTED: int

class KernelError(Exception): ...
class KernelFatalError(KernelError): ...
class KernelCapacityError(KernelError): ...
class ActionQueueFullError(KernelError): ...
class KernelPoisonedError(KernelError): ...
class ReentrantError(KernelError): ...
class SnapshotUnsupportedError(KernelError): ...
class SnapshotIoError(KernelError): ...
class SnapshotRestoreError(KernelError): ...
class CausalityViolationError(KernelFatalError): ...
class SequenceViolationError(KernelFatalError): ...
class PortFailureError(KernelFatalError): ...
class ResultOverflowError(KernelFatalError): ...
class StrategyFailureError(KernelFatalError): ...
class KernelPanicError(KernelFatalError): ...

class StrategyProtocol(Protocol):
    def on_event(self, ctx: StrategyContext, event: EventRecordView) -> int: ...

class BatchStrategyProtocol(Protocol):
    def on_events(self, ctx: StrategyContext, batch: EventBatchView) -> int: ...

class SnapshotPortProtocol(Protocol):
    def store(self, blob: bytes, logical_time_ns: int, event_count: int) -> None: ...

class KernelConfig:
    def __init__(
        self,
        history_ring_len: int,
        arena_size: int,
        strategy_arena_offset: int = 0,
        strategy_arena_size: int = 0,
        action_queue_capacity: int = 1024,
        payload_record_size: int = 64,
        price_scale_exp: int = -2,
        qty_scale_exp: int = -2,
        prng_seed: int = 0,
        exec_state_max_bytes: int = 1024,
        feed_token_max_bytes: int = 4096,
        hash_interval: int = 0,
        trace_enabled: bool = False,
        max_total_bytes: int = 268_435_456,
    ) -> None: ...
    @property
    def history_ring_len(self) -> int: ...
    @property
    def arena_size(self) -> int: ...
    @property
    def strategy_arena_offset(self) -> int: ...
    @property
    def strategy_arena_size(self) -> int: ...
    @property
    def action_queue_capacity(self) -> int: ...
    @property
    def payload_record_size(self) -> int: ...
    @property
    def price_scale_exp(self) -> int: ...
    @property
    def qty_scale_exp(self) -> int: ...
    @property
    def prng_seed(self) -> int: ...
    @property
    def exec_state_max_bytes(self) -> int: ...
    @property
    def feed_token_max_bytes(self) -> int: ...
    @property
    def hash_interval(self) -> int: ...
    @property
    def trace_enabled(self) -> bool: ...
    @property
    def max_total_bytes(self) -> int: ...

class StepResult:
    @property
    def status(self) -> int: ...
    @property
    def detail(self) -> int: ...
    @property
    def processed_event_count(self) -> int: ...
    @property
    def now_ns(self) -> int: ...

class EventRecordView:
    @property
    def timestamp_ns(self) -> int: ...
    @property
    def sequence_id(self) -> int: ...
    @property
    def stream_id(self) -> int: ...
    @property
    def event_type(self) -> int: ...
    @property
    def flags(self) -> int: ...
    @property
    def payload_idx(self) -> int: ...
    @property
    def payload(self) -> bytes: ...

class EventBatchView:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> EventRecordView: ...
    def __buffer__(self, flags: int) -> memoryview: ...
    def __releasebuffer__(self, view: memoryview) -> None: ...

class HistoryView:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> EventRecordView: ...
    def latest(self) -> EventRecordView | None: ...

class StrategyArenaView:
    def __len__(self) -> int: ...
    def tobytes(self) -> bytes: ...
    def __getitem__(self, index: int | slice) -> Any: ...
    def __setitem__(self, index: int | slice, value: Any) -> None: ...
    def __buffer__(self, flags: int) -> memoryview: ...
    def __releasebuffer__(self, view: memoryview) -> None: ...

class StrategyContext:
    @property
    def now_ns(self) -> int: ...
    @property
    def history(self) -> HistoryView: ...
    @property
    def strategy_arena(self) -> StrategyArenaView: ...
    def prng_next_u64(self) -> int: ...
    def submit_action(self, action_kind: int, latency_ns: int, payload: bytes | None = None) -> int: ...

class InMemoryMarketFeed:
    def __init__(self, timestamps: Sequence[int], stream_id: int = 0, event_type: int = 1) -> None: ...

class SimExecution:
    def __init__(self, delay_ns: int = 5) -> None: ...

class ArrowResultStream:
    @property
    def table_name(self) -> str: ...
    @property
    def row_count(self) -> int: ...
    def buffer_addresses(self) -> list[int]: ...
    def release_count(self) -> int: ...
    def digest(self) -> bytes: ...
    def __arrow_c_stream__(self, requested_schema: object | None = None) -> object: ...

class DiskSnapshotPort:
    def __init__(self, dir: str, run_id: str) -> None: ...
    def cleaned_tmp_files(self) -> int: ...
    def snapshot_path(self, logical_time_ns: int, event_count: int) -> str: ...
    def store(self, blob: bytes, logical_time_ns: int, event_count: int) -> None: ...
    def load(self, logical_time_ns: int, event_count: int) -> bytes: ...

class DiskTraceSink:
    def __init__(self, dir: str, run_id: str) -> None: ...
    def path(self) -> str: ...
    def write_header(self, header_bytes: bytes) -> None: ...
    def write(self, record_bytes: bytes) -> None: ...
    def sync(self) -> None: ...

class Kernel:
    def __init__(
        self,
        config: KernelConfig,
        feeds: Sequence[Any],
        execution: Any,
        strategy: Any,
        trace_sink: Any | None = None,
    ) -> None: ...
    def state(self) -> str: ...
    def step(self) -> StepResult: ...
    def run(self, max_events: int | None = None) -> StepResult: ...
    @staticmethod
    def benchmark_batch_callbacks(
        strategy: Any,
        timestamps: Sequence[int],
        batch_size: int = 64,
        payload_record_size: int = 64,
    ) -> int: ...
    def init_strategy_arena(self, offset: int, data: bytes) -> None: ...
    def read_strategy_arena(self, offset: int = 0, length: int | None = None) -> bytes: ...
    def capture(self, snapshot_port: Any) -> None: ...
    def restore(self, blob: bytes) -> None: ...
    def state_digest(self) -> bytes: ...
    def export_fills(self) -> ArrowResultStream: ...
    def export_equity(self) -> ArrowResultStream: ...
    def export_transitions(self) -> ArrowResultStream: ...
    def close(self) -> None: ...
    def __enter__(self) -> Kernel: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> bool: ...
    def _debug_trigger_internal_panic(self) -> None: ...
